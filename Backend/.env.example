PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string (no database name at the end)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net

ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

RESET_PASSWORD_SECRET=your_reset_password_secret
RESET_PASSWORD_EXPIRY=5m
EMAIL_VERIFY_SECRET=your_email_verify_secret
EMAIL_VERIFY_EXPIRY=5m

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NODEMAILER_EMAIL=
NODEMAILER_APP_PASSWORD=

# Frontend URL (email links, CORS when API and UI are on different hosts)
CLIENT_ORIGIN=http://localhost:5173

# Set to "true" on Render single-service deploy (serves Frontend/dist from Express)
SERVE_FRONTEND=false
